# JanusTower configuration template.
# Copy to .env (never commit .env) and fill in your own values.
# Real environment variables always take precedence over this file.

# --- Google OAuth client (REQUIRED for login) ---
# Create it in your own GCP project: APIs & Services > Credentials > Create credentials >
# OAuth client ID > Application type "Desktop app". See README, "Create your OAuth client".
GCP_OAUTH_CLIENT_ID=
GCP_OAUTH_CLIENT_SECRET=

# --- Demo mode ---
# Try JanusTower without Google: invented data ("Acme Corp"), no login, no network, your real data is never read or written.
# The sample data lives in a temporary folder that is removed when the server stops, and the Host allow-list is fixed to the loopback names (the server listens on HOST, 127.0.0.1 by default).
# 1 = demo mode ON.
# 0 = demo mode OFF, always (the normal application).
# Unset (default) = demo mode turns on by itself ONLY when the OAuth client above is not configured.
# It is decided once, at startup (from this file or from the environment, e.g.  JANUSTOWER_DEMO=1 python server.py): it cannot be
# changed from the browser. While the demo runs, nothing else in this file is read.
# JANUSTOWER_DEMO=

# --- Server ---
# Defaults: HOST=127.0.0.1, PORT=8095. Leave HOST commented if you use Docker
# (--env-file would override the container's HOST=0.0.0.0 and make the app unreachable).
# HOST=127.0.0.1
# PORT=8095
# Host used in the OAuth redirect URI and in the URL printed at startup.
LOOPBACK_HOST=localhost
# Optional: override the OAuth redirect URI (default: http://LOOPBACK_HOST:PORT/oauth2callback).
# OAUTH_REDIRECT_URI=
# Optional: URL printed at startup (default: http://LOOPBACK_HOST:PORT).
# PUBLIC_BASE_URL=
# Optional: extra Host/Origin hosts accepted (comma-separated, e.g. behind a reverse proxy).
# ALLOWED_HOSTS=
# 1 = open the browser automatically at startup.
AUTO_OPEN_BROWSER=0

# Content-Security-Policy: by default the browser blocks any script the page did not declare.
# 1 = send the same policy in report-only mode (nothing is blocked; violations show up in the browser console).
# CSP_REPORT_ONLY=1
